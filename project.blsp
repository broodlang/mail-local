;; mail-local — a `mail` adapter that keeps every email in the app itself, with a page to
;; read them. No SMTP, no vendor: a laptop's mailbox, or a staging deploy's.
(project
  :name "mail-local"
  :version "0.1.0"
  :brood ">= 0.29.2"
  :description
    "A mail adapter that keeps every email in-process, bounded, with a hatch page to read them — Swoosh's mailbox preview, for development and staging."
  :repository "https://github.com/broodlang/mail-local"
  :dependencies [[mail :version "^0.1.0"] [hatch :version "^0.23.0"]])
